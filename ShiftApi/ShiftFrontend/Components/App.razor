@inherits LayoutComponentBase
@inject HttpClient Http
@inject NavigationManager Nav

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ShiftFrontend.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

<div class="page">
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private static bool _checkedOnce = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_checkedOnce) return;

        _checkedOnce = true;

        // すでに /setup にいるなら余計な遷移しない
        if (Nav.Uri.Contains("/setup")) return;

        var s = await Http.GetFromJsonAsync<SetupStatus>("setup/status");
        if (s?.NeedsSetup == true)
        {
            Nav.NavigateTo("/setup", forceLoad: true);
        }
    }

    private class SetupStatus { public bool NeedsSetup { get; set; } }
}
