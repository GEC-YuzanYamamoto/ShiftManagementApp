@inject ShiftFrontend.Services.AuthState Auth
@inject ShiftFrontend.Services.ShiftApiClient Api
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CalenShift</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (!Auth.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                    ログイン
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="shift-calendar">
                    シフトカレンダー
                </NavLink>
            </div>

            @if (Auth.Role == "Admin")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="shift-management">
                        シフト管理
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        ユーザー管理
                    </NavLink>
                </div>
            }
        }

        @if (Auth.IsLoggedIn)
        {
            <div class="nav-item px-3 logout-item">
                <button class="nav-link btn btn-link" @onclick="LogoutAsync">
                    ログアウト
                </button>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }

    private async Task LogoutAsync()
    {
        Auth.Logout();
        await Api.ClearTokenAsync();

        // ログアウト後はログインページへ
        Nav.NavigateTo("login", forceLoad: true);
    }
}
