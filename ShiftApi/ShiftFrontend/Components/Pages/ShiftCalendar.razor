@page "/shift-calendar"
@rendermode InteractiveServer
@using ShiftFrontend.Models
@inject ShiftFrontend.Services.ShiftApiClient Api
@inject ShiftFrontend.Services.AuthState Auth
@inject NavigationManager Nav

<h3>ShiftCalender</h3>
<h3>シフトカレンダー</h3>

<div class="mb-2">
    <button @onclick="PrevMonth">＜</button>
    <span style="margin:0 1rem;">@CurrentMonth.Year 年 @CurrentMonth.Month 月</span>
    <button @onclick="NextMonth">＞</button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

<table class="table table-bordered" style="width:auto;">
    <thead>
        <tr>
            @foreach (var d in WeekDays)
            {
                <th>@d</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var week in CalendarWeeks)
        {
            <tr>
                @foreach (var day in week)
                {
                    if (day == null)
                    {
                        <td></td>
                    }
                    else
                    {
                        var date = day.Value;
                        var shift = Shifts.FirstOrDefault(s => s.ShiftDate == date);

                        <td class="calendar-cell @(date == DateOnly.FromDateTime(DateTime.Today) ? "today" : "")"
                            @onclick="@(() => OnDateClick(date))">
                            <div>@date.Day</div>

                            @if (shift != null)
                            {
                                <div class="small">@GetShiftLabel(shift.ShiftType)</div>
                            }
                        </td>
                    }
                }
            </tr>
        }
    </tbody>
</table>

@if (SelectedDate != null)
{
    <div class="shift-modal-overlay">
        <div class="shift-modal">
            <h4>@SelectedDate.Value.ToString("yyyy/MM/dd") のシフト希望</h4>

            <div>
                <select @bind="SelectedShiftTypeString">
                    <option value="">選択してください</option>
                    <option value="1">早番</option>
                    <option value="2">遅番</option>
                    <option value="3">夜勤</option>
                </select>
            </div>

            <div style="margin-top:1rem;">
                <button @onclick="SaveShift">保存</button>
                <button @onclick="CloseModal" style="margin-left:0.5rem;">キャンセル</button>
            </div>

            @if (!string.IsNullOrEmpty(modalMessage))
            {
                <p>@modalMessage</p>
            }
        </div>
    </div>
}


@code {
    private DateOnly CurrentMonth = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<ShiftRequestDto> Shifts = new();
    private List<List<DateOnly?>> CalendarWeeks = new();

    private string? message;
    private DateOnly? SelectedDate;
    private string? SelectedShiftTypeString;
    private string? modalMessage;

    private static readonly string[] WeekDays = new[] { "日", "月", "火", "水", "木", "金", "土" };

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login", true);  // 強制的にログインへ
            return;
        }

        await LoadMonthAsync();
    }


    private async Task LoadMonthAsync()
    {
        message = null;
        modalMessage = null;

        Shifts = await Api.GetMyShiftRequestsForMonthAsync(CurrentMonth.Year, CurrentMonth.Month);
        if (Shifts.Count == 0)
        {
            message = "シフト希望がありません。（未ログインの場合もここが空になります）";
        }

        BuildCalendar();
    }

    // ★ 余計な空行が出ないように、必要な週だけ作る
    private void BuildCalendar()
    {
        CalendarWeeks.Clear();

        var first = CurrentMonth;                          // 月初 (1日)
        var last = first.AddMonths(1).AddDays(-1);        // 月末

        // カレンダー開始：その月の1日の属する週の日曜日
        int firstOffset = (int)first.DayOfWeek;            // Sunday=0
        var firstDateToShow = first.AddDays(-firstOffset);

        // カレンダー終了：月末の属する週の土曜日
        int lastOffset = 6 - (int)last.DayOfWeek;          // Saturday=6
        var lastDateToShow = last.AddDays(lastOffset);

        var cursor = firstDateToShow;

        while (cursor <= lastDateToShow)
        {
            var week = new List<DateOnly?>();

            for (int d = 0; d < 7; d++)
            {
                if (cursor.Month == CurrentMonth.Month)
                {
                    week.Add(cursor);
                }
                else
                {
                    week.Add(null);
                }

                cursor = cursor.AddDays(1);
            }

            CalendarWeeks.Add(week);
        }
    }

    private async Task PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        await LoadMonthAsync();
    }

    private async Task NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        await LoadMonthAsync();
    }

    private void OnDateClick(DateOnly date)
    {
        SelectedDate = date;

        // 既に登録済みなら初期値をセット
        var existing = Shifts.FirstOrDefault(s => s.ShiftDate == date);
        SelectedShiftTypeString = existing?.ShiftType.ToString() ?? "";

        modalMessage = null;
    }

    private async Task SaveShift()
    {
        modalMessage = null;

        if (SelectedDate == null)
        {
            modalMessage = "日付が選択されていません。";
            return;
        }

        if (string.IsNullOrEmpty(SelectedShiftTypeString) ||
            !int.TryParse(SelectedShiftTypeString, out var shiftType))
        {
            modalMessage = "シフト種別を選択してください。";
            return;
        }

        var ok = await Api.CreateShiftRequestAsync(SelectedDate.Value, shiftType);
        if (!ok)
        {
            modalMessage = "保存に失敗しました。";
            return;
        }

        await LoadMonthAsync();   // 再読み込みして反映
        SelectedDate = null;      // モーダルを閉じる
    }

    private void CloseModal()
    {
        SelectedDate = null;
        modalMessage = null;
    }

    private string GetShiftLabel(int shiftType) => shiftType switch
    {
        1 => "早番",
        2 => "遅番",
        3 => "夜勤",
        _ => "未設定"
    };
}
