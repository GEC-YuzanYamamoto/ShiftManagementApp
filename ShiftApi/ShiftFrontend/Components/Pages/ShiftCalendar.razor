@page "/shift-calendar"
@using ShiftFrontend.Models
@using ShiftFrontend.Utils
@using System.Text
@inject ShiftFrontend.Services.ShiftApiClient Api
@inject ShiftFrontend.Services.AuthState Auth
@inject NavigationManager Nav

<h4>シフトカレンダー</h4>
<hr />

@if (!Auth.IsLoggedIn)
{
    <p>ログインしていません。ログインしてください。</p>
    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/login"))">ログインへ</button>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">＜ 前月</button>
        <h4 class="m-0">@currentMonth.ToString("yyyy年MM月")</h4>
        <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">翌月 ＞</button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <p>@message</p>
    }

    <table class="table table-bordered calendar-table">
        <thead class="table-light">
            <tr>
                <th class="text-center">日</th>
                <th class="text-center">月</th>
                <th class="text-center">火</th>
                <th class="text-center">水</th>
                <th class="text-center">木</th>
                <th class="text-center">金</th>
                <th class="text-center">土</th>
            </tr>
        </thead>

        <tbody>
            @for (int week = 0; week < weeksNeeded; week++)
            {
                <tr>
                    @for (int day = 0; day < 7; day++)
                    {
                        var date = calendarStartDate.AddDays(week * 7 + day);
                        var d = DateOnly.FromDateTime(date);

                        var requests = ShiftRequests.Where(x => x.ShiftDate == d).ToList();
                        var schedules = ShiftSchedules.Where(x => x.ShiftDate == d).ToList();

                        bool isOther = date.Month != currentMonth.Month;
                        bool selectable = IsSelectable(d);

                        <td class="@($"{GetCellClass(date, isOther)} {GetSelectableClass(selectable)} calendar-cell")"
                            title="@GetDayTooltip(date, requests, schedules)"
                            @onclick="@(selectable ? (() => OnDateClick(d)) : null)"
                            style="@GetCellStyle(selectable)">

                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">@date.Day</span>

                                @if (date.Date == DateTime.Today.Date)
                                {
                                    <span class="badge bg-primary">今日</span>
                                }
                            </div>

                            @if (schedules.Any())
                            {
                                <div class="mt-1">
                                    <span class="badge bg-success">確定 @schedules.Count 件</span>
                                </div>
                            }

                            @if (requests.Any())
                            {
                                <div class="mt-1">
                                    <span class="badge bg-warning text-dark">希望 @requests.Count 件</span>
                                </div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @if (selectedDate.HasValue)
    {
        <div class="shift-modal-overlay">
            <div class="shift-modal">
                <h4>@selectedDate.Value.ToString("yyyy/MM/dd") の希望シフト</h4>

                <select @bind="selectedShiftType" class="form-select mb-3">
                    <option value="">選択してください</option>
                    <option value="1">早番</option>
                    <option value="2">遅番</option>
                    <option value="3">夜勤</option>
                    <option value="4">休み</option>
                </select>

                <button class="btn btn-primary" @onclick="SaveShift">保存</button>
                <button class="btn btn-secondary ms-2" @onclick="CloseModal">キャンセル</button>

                @if (!string.IsNullOrEmpty(modalMessage))
                {
                    <p class="mt-2 text-danger">@modalMessage</p>
                }
            </div>
        </div>
    }
}


@code {
    private DateTime currentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime calendarStartDate;
    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    // 今日以前を選択不可（今日も不可）
    private bool IsSelectable(DateOnly d) => d > Today;

    private int weeksNeeded;

    private List<ShiftRequestDto> ShiftRequests = new();
    private List<ShiftScheduleDto> ShiftSchedules = new();

    private string? message;
    private DateOnly? selectedDate;
    private string? selectedShiftType;
    private string? modalMessage;

    private List<UserDto> users = new();
    private Dictionary<int, string> userNameMap = new();

    private readonly Dictionary<byte, string> shiftTypeLabels = new()
    {
        { 1, "早番" },
        { 2, "遅番" },
        { 3, "夜勤" },
        { 4, "休み" }
    };

    // --- ライフサイクル ---
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadUsers();

        (calendarStartDate, weeksNeeded) = CalendarUtil.CalculateMonth(currentMonth);
        await LoadCalendar();
    }

    // --- 月移動・選択など UI イベント ---
    private async Task PrevMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        (calendarStartDate, weeksNeeded) = CalendarUtil.CalculateMonth(currentMonth);
        await LoadCalendar();
    }
    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        (calendarStartDate, weeksNeeded) = CalendarUtil.CalculateMonth(currentMonth);
        await LoadCalendar();
    }
    private async Task SaveShift()
    {
        if (selectedDate == null)
        {
            modalMessage = "日付が選択されていません。";
            return;
        }

        if (string.IsNullOrEmpty(selectedShiftType) ||
            !int.TryParse(selectedShiftType, out var type))
        {
            modalMessage = "シフト種別を選択してください。";
            return;
        }

        var ok = await Api.CreateShiftRequestAsync(selectedDate.Value, type);

        if (!ok)
        {
            modalMessage = "保存に失敗しました。";
            return;
        }

        await LoadCalendar();
        selectedDate = null;
    }
    private void OnDateClick(DateOnly d)
    {
        if (!IsSelectable(d))
            return;

        selectedDate = d;

        var existing = ShiftRequests.FirstOrDefault(x => x.ShiftDate == d);
        selectedShiftType = existing?.ShiftType.ToString() ?? "";
        modalMessage = null;
    }
    private void CloseModal()
    {
        selectedDate = null;
        modalMessage = null;
    }
    private string GetSelectableClass(bool selectable)
    => selectable ? "calendar-active" : "calendar-disabled";
    private string GetCellStyle(bool selectable)
        => selectable
            ? "cursor:pointer; vertical-align:top;"
            : "cursor:not-allowed; vertical-align:top; opacity:0.6;";

    // --- データ取得 ---
    private async Task LoadUsers()
    {
        try
        {
            users = await Api.GetUsersAsync();
            userNameMap = users.ToDictionary(u => u.Id, u => u.Name);
        }
        catch
        {
            users = new();
            userNameMap = new();
        }
    }
    private async Task LoadCalendar()
    {
        message = null;

        var (start, end) = CalendarUtil.GetDisplayRange(calendarStartDate, weeksNeeded);

        ShiftRequests = await Api.GetShiftRequestsAsync(start, end);
        ShiftSchedules = await Api.GetShiftSchedulesAsync(start, end);
    }

    // --- カレンダー計算・表示ロジック ---
    private string GetCellClass(DateTime date, bool isOther)
    {
        var classes = new List<string> { "text-start", "align-top" };

        if (isOther)
        {
            classes.Add("text-muted");
            classes.Add("bg-light");
        }

        if (selectedDate.HasValue && selectedDate.Value == DateOnly.FromDateTime(date))
            classes.Add("border-primary border-2");

        return string.Join(" ", classes);
    }
    private string GetUserName(int userId)
    {
        if (Auth.Role == "Admin")
        {
            if (userNameMap.TryGetValue(userId, out var name))
                return name;

            return $"ID:{userId}";
        }
        return "";
    }
    // ShiftType のラベルを取得
    private string GetShiftTypeLabel(byte shiftType)
    {
        if (shiftTypeLabels.TryGetValue(shiftType, out var label))
        {
            return label;
        }

        return $"タイプ{shiftType}";
    }
    // 日付のツールチップテキストを生成
    private string GetDayTooltip(
    DateTime date,
    List<ShiftRequestDto> dayRequests,
    List<ShiftScheduleDto> daySchedules)
    {
        var sb = new StringBuilder();

        sb.AppendLine(date.ToString("yyyy年MM月dd日 (ddd)"));

        if (!dayRequests.Any() && !daySchedules.Any())
        {
            sb.Append("シフトなし");
            return sb.ToString();
        }

        if (daySchedules.Any())
        {
            sb.AppendLine("[確定シフト]");
            foreach (var s in daySchedules.OrderBy(x => x.ShiftType))
            {
                var name = GetUserName(s.UserId);

                sb.Append("・");

                if (!string.IsNullOrEmpty(name))
                {
                    sb.Append(name)
                      .Append("：");
                }

                sb.Append(GetShiftTypeLabel(s.ShiftType))
                  .AppendLine();

            }
        }

        if (dayRequests.Any())
        {
            sb.AppendLine("[希望シフト]");
            foreach (var r in dayRequests.OrderBy(x => x.ShiftType))
            {
                var name = GetUserName(r.UserId);

                sb.Append("・");

                if (!string.IsNullOrEmpty(name))
                {
                    sb.Append(name)
                      .Append("：");
                }

                sb.Append(GetShiftTypeLabel(r.ShiftType))
                  .AppendLine();

            }
        }

        return sb.ToString();
    }
}
