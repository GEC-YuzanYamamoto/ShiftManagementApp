<h3>Login</h3>

@page "/"
@page "/login"
@rendermode InteractiveServer
@inject ShiftFrontend.Services.ShiftApiClient Api
@inject ShiftFrontend.Services.AuthState Auth
@inject NavigationManager Nav

<h3>ログイン</h3>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

<div>
    <label>メールアドレス：</label>
    <input @bind="email" />
</div>
<div>
    <label>パスワード：</label>
    <input type="password" @bind="password" />
</div>

<button @onclick="OnLogin">ログイン</button>

@code {
    private string email = "";
    private string password = "";
    private string? message;

    private async Task OnLogin()
    {
        var success = await Api.LoginAsync(email, password);
        if (!success)
        {
            message = "ログインに失敗しました。";
            return;
        }

        Auth.SetLogin("Admin");

        Nav.NavigateTo("/shift-calendar");  // or /shift, /admin/shift
    }
}
