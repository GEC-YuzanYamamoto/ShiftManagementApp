@page "/shift-management"
@using ShiftFrontend.Models
@using System.Text
@inject ShiftFrontend.Services.ShiftApiClient Api
@inject ShiftFrontend.Services.AuthState Auth
@inject NavigationManager Nav

<h4>シフト管理（カレンダー）</h4>
<hr />

@if (!Auth.IsLoggedIn)
{
    <p>ログインしていません。先にログインしてください。</p>
    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("login"))">ログイン画面へ</button>
}
else if (Auth.Role != "Admin")
{
    <p>このページは管理者専用です。</p>
}
else
{
    @if (!string.IsNullOrEmpty(loadError))
    {
        <p style="color:red;">エラー: @loadError</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(message))
        {
            <p>@message</p>
        }

        <!-- 月移動＆ヘッダー -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">＜ 前月</button>
            <h4 class="m-0">@currentMonth.ToString("yyyy年MM月")</h4>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">翌月 ＞</button>
        </div>

        <!-- カレンダー本体（可変式：前月・翌月も含めて6×7表示） -->
        <table class="table table-bordered calendar-table">
            <thead class="table-light">
                <tr>
                    <th class="text-center">日</th>
                    <th class="text-center">月</th>
                    <th class="text-center">火</th>
                    <th class="text-center">水</th>
                    <th class="text-center">木</th>
                    <th class="text-center">金</th>
                    <th class="text-center">土</th>
                </tr>
            </thead>
            <tbody>
                @for (int week = 0; week < weeksNeeded; week++)
                {
                    <tr>
                        @for (int day = 0; day < 7; day++)
                        {
                            var date = calendarStartDate.AddDays(week * 7 + day);
                            var d = DateOnly.FromDateTime(date);

                            var dayRequests = requests
                            .Where(r => r.ShiftDate == d)
                            .ToList();

                            var daySchedules = schedules
                            .Where(s => s.ShiftDate == d)
                            .ToList();

                            bool isOtherMonth = date.Month != currentMonth.Month;

                            <td class="@GetCellClass(date, isOtherMonth) calendar-cell"
                                @onclick="@(() => OnSelectDate(date))"
                                title="@GetDayTooltip(date, dayRequests, daySchedules)"
                                style="cursor:pointer; vertical-align:top;">

                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold">@date.Day</span>
                                    @if (date.Date == DateTime.Today.Date)
                                    {
                                        <span class="badge bg-primary">今日</span>
                                    }
                                </div>

                                @if (daySchedules.Any())
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-success">確定 @daySchedules.Count 件</span>
                                    </div>
                                }

                                @if (dayRequests.Any())
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-warning text-dark">希望 @dayRequests.Count 件</span>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <!-- 選択した日の詳細 -->
        @if (selectedDate.HasValue)
        {
            var dateOnly = DateOnly.FromDateTime(selectedDate.Value);
            var listRequests = requests
                .Where(r => r.ShiftDate == dateOnly)
                .OrderBy(r => r.ShiftType)
                .ToList();

            var listSchedules = schedules
                .Where(s => s.ShiftDate == dateOnly)
                .OrderBy(s => s.ShiftType)
                .ToList();

            <div class="card mt-3">
                <div class="card-header">
                    @selectedDate.Value.ToString("yyyy年MM月dd日 (ddd)") のシフト詳細
                </div>
                <div class="card-body">

                    @if (!listRequests.Any() && !listSchedules.Any())
                    {
                        <p>この日には希望シフトも確定シフトもありません。</p>
                    }
                    else
                    {
                        @if (listSchedules.Any())
                        {
                            <h6>確定シフト</h6>
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-success">
                                    <tr>
                                        <th>スタッフ</th>
                                        <th>シフト種別</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in listSchedules)
                                    {
                                        <tr class="@(selectedSchedule?.Id == s.Id ? "table-primary" : "")">
                                            <td>@GetUserName(s.UserId)</td>
                                            <td>@GetShiftTypeLabel(s.ShiftType)</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="@(() => OnSelectSchedule(s))">
                                                    変更
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (listRequests.Any())
                        {
                            <h6 class="mt-3">希望シフト</h6>
                            <table class="table table-sm table-hover table-bordered align-middle">
                                <thead class="table-warning">
                                    <tr>
                                        <th>スタッフ</th>
                                        <th>希望シフト種別</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in listRequests)
                                    {
                                        <tr class="@(selectedRequest?.Id == r.Id ? "table-primary" : "")">
                                            <td>@GetUserName(r.UserId)</td>
                                            <td>@GetShiftTypeLabel(r.ShiftType)</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="@(() => OnSelectRequest(r))">
                                                    選択
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @* -----------------------------
                       希望シフト：承認/変更（既存）
                       ----------------------------- *@
                    @if (selectedRequest is not null)
                    {
                        <hr />
                        <h6>選択中の希望を承認 / 変更</h6>
                        <p class="mb-1">
                            スタッフ：@GetUserName(selectedRequest.UserId)
                        </p>
                        <p class="mb-2">
                            日付：@selectedRequest.ShiftDate.ToString("yyyy年MM月dd日")
                        </p>

                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">確定シフト種別</label>
                                <select class="form-select" @bind="editShiftType">
                                    @foreach (var kv in shiftTypeLabels)
                                    {
                                        <option value="@kv.Key">@kv.Value (@kv.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-success me-2"
                                    @onclick="ApproveWithEdit"
                                    disabled="@isSaving">
                                @(isSaving ? "処理中..." : "このシフト種別で承認して確定")
                            </button>

                            <button class="btn btn-outline-secondary"
                                    @onclick="ClearSelection"
                                    disabled="@isSaving">
                                選択解除
                            </button>
                        </div>
                    }

                    @* -----------------------------
                       ★確定シフト：変更（追加）
                       ----------------------------- *@
                    @if (selectedSchedule is not null)
                    {
                        <hr />
                        <h6>確定シフトの変更</h6>

                        <p class="mb-1">スタッフ：@GetUserName(selectedSchedule.UserId)</p>
                        <p class="mb-2">日付：@selectedSchedule.ShiftDate.ToString("yyyy年MM月dd日")</p>

                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">変更後のシフト種別</label>
                                <select class="form-select" @bind="editScheduleShiftType">
                                    @foreach (var kv in shiftTypeLabels)
                                    {
                                        <option value="@kv.Key">@kv.Value (@kv.Key)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary me-2"
                                    @onclick="UpdateSchedule"
                                    disabled="@isSaving">
                                @(isSaving ? "処理中..." : "確定シフトを更新")
                            </button>

                            <button class="btn btn-outline-secondary"
                                    @onclick="ClearScheduleSelection"
                                    disabled="@isSaving">
                                選択解除
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@code {
    private bool isLoaded = false;
    private string? loadError;
    private string? message;

    private List<UserDto> users = new();
    private Dictionary<int, string> userNameMap = new();

    private int weeksNeeded;
    // 当月1日
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    // カレンダー表示開始（日曜日始まり）
    private DateTime calendarStartDate;

    private List<ShiftRequestDto> requests = new();
    private List<ShiftScheduleDto> schedules = new();

    private DateTime? selectedDate;

    private ShiftRequestDto? selectedRequest;
    private ShiftScheduleDto? selectedSchedule;

    private byte editShiftType = 1;
    private byte editScheduleShiftType = 1;

    private bool isSaving = false;

    private readonly Dictionary<byte, string> shiftTypeLabels = new()
    {
        { 1, "早番" },
        { 2, "遅番" },
        { 3, "夜勤" },
        { 4, "休み" }
    };

    // --- ライフサイクル ---
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || Auth.Role != "Admin")
        {
            return;
        }

        CalcCalendarStart();   // 可変式の開始日を計算
        await LoadUsers();
        await LoadCalendarData();
    }

    // --- 月移動・選択など UI イベント ---
    private async Task PrevMonth()
    {
        if (!isLoaded) return;

        currentMonth = currentMonth.AddMonths(-1);
        selectedDate = null;

        selectedRequest = null;
        selectedSchedule = null;
        editShiftType = 1;
        editScheduleShiftType = 1;

        CalcCalendarStart();
        await LoadCalendarData();
    }
    private async Task NextMonth()
    {
        if (!isLoaded) return;

        currentMonth = currentMonth.AddMonths(1);
        selectedDate = null;

        selectedRequest = null;
        selectedSchedule = null;
        editShiftType = 1;
        editScheduleShiftType = 1;

        CalcCalendarStart();
        await LoadCalendarData();
    }
    private void OnSelectDate(DateTime date)
    {
        selectedDate = date.Date;

        // 日付選択時に状態をクリア（事故防止）
        selectedRequest = null;
        selectedSchedule = null;
        editShiftType = 1;
        editScheduleShiftType = 1;
    }
    private void OnSelectRequest(ShiftRequestDto req)
    {
        selectedRequest = req;
        selectedSchedule = null; // ★競合防止
        editShiftType = req.ShiftType; // デフォルトは希望と同じ ShiftType
    }
    private void OnSelectSchedule(ShiftScheduleDto s)
    {
        selectedSchedule = s;
        selectedRequest = null; // ★競合防止
        editScheduleShiftType = s.ShiftType;
    }
    // 希望 → 確定
    private async Task ApproveWithEdit()
    {
        if (selectedRequest is null)
        {
            return;
        }

        message = null;
        isSaving = true;

        try
        {
            var dto = new ShiftManagementDto
            {
                UserId = selectedRequest.UserId,
                ShiftDate = selectedRequest.ShiftDate,
                ShiftType = editShiftType
            };

            var ok = await Api.CreateShiftAsync(dto);

            if (!ok)
            {
                message = "シフト確定に失敗しました。";
                return;
            }

            message = "シフトを確定しました。";

            selectedRequest = null;
            editShiftType = 1;

            await LoadCalendarData();
        }
        catch (Exception ex)
        {
            message = $"エラー: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
    // 確定シフトの変更
    private async Task UpdateSchedule()
    {
        if (selectedSchedule is null) return;

        message = null;
        isSaving = true;

        try
        {
            var ok = await Api.UpdateShiftScheduleAsync(selectedSchedule.Id, editScheduleShiftType);
            if (!ok)
            {
                message = "確定シフトの更新に失敗しました。";
                return;
            }

            message = "確定シフトを更新しました。";

            selectedSchedule = null;
            editScheduleShiftType = 1;

            await LoadCalendarData();
        }
        catch (Exception ex)
        {
            message = $"エラー: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
    private void ClearSelection()
    {
        selectedRequest = null;
        editShiftType = 1;
    }
    private void ClearScheduleSelection()
    {
        selectedSchedule = null;
        editScheduleShiftType = 1;
    }

    // --- データ取得 ---
    // ユーザー一覧を取得してマップを作成
    private async Task LoadUsers()
    {
        try
        {
            users = await Api.GetUsersAsync();
            userNameMap = users.ToDictionary(u => u.Id, u => u.Name);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ユーザー取得エラー: {ex.Message}");
            users = new();
            userNameMap = new();
        }
    }
    // カレンダー範囲のシフト希望＆確定シフトを取得
    private async Task LoadCalendarData()
    {
        try
        {
            isLoaded = false;
            loadError = null;
            message = null;

            // カレンダー開始日から weeksNeeded 週分を取得
            var start = DateOnly.FromDateTime(calendarStartDate);
            var end = DateOnly.FromDateTime(calendarStartDate.AddDays(weeksNeeded * 7 - 1));

            // 希望（未承認のみ）
            var allRequests = await Api.GetShiftRequestsAsync(start, end);
            requests = allRequests
                .Where(r => r.Status == 0)
                .ToList();

            // 確定
            schedules = await Api.GetShiftSchedulesAsync(start, end);

            // 初回は今日が範囲内なら今日、そうでなければ当月1日
            if (!selectedDate.HasValue)
            {
                var calendarEnd = calendarStartDate.AddDays(weeksNeeded * 7 - 1);

                if (DateTime.Today >= calendarStartDate && DateTime.Today <= calendarEnd)
                {
                    selectedDate = DateTime.Today;
                }
                else
                {
                    selectedDate = currentMonth;
                }
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoaded = true;
        }
    }

    // --- カレンダー計算・表示ロジック ---
    // 当月1日の曜日から、カレンダー表示開始（日曜日）を求める
    private void CalcCalendarStart()
    {
        var first = currentMonth;              // 当月1日
        int diff = (int)first.DayOfWeek;       // 日=0, 月=1,...
        calendarStartDate = first.AddDays(-diff);

        var lastDay = new DateTime(currentMonth.Year, currentMonth.Month,
        DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month));

        var lastDayOfCalendar = lastDay.AddDays(-(int)lastDay.DayOfWeek + 6);
        weeksNeeded = ((lastDayOfCalendar - calendarStartDate).Days + 1) / 7;
    }
    // 日付セルのCSSクラスを取得
    private string GetCellClass(DateTime date, bool isOtherMonth)
    {
        var classes = new List<string> { "text-start", "align-top" };

        if (isOtherMonth)
        {
            classes.Add("text-muted");
            classes.Add("bg-light");
        }

        if (selectedDate.HasValue && selectedDate.Value.Date == date.Date)
        {
            classes.Add("border-primary");
            classes.Add("border-2");
        }

        return string.Join(" ", classes);
    }
    // ShiftType のラベルを取得
    private string GetShiftTypeLabel(byte shiftType)
    {
        if (shiftTypeLabels.TryGetValue(shiftType, out var label))
        {
            return label;
        }

        return $"タイプ{shiftType}";
    }
    // ユーザーIDから名前を取得
    private string GetUserName(int userId)
    {
        if (userNameMap.TryGetValue(userId, out var name))
        {
            return name;
        }

        return $"ID:{userId}";
    }
    // 日付セルのツールチップ内容を取得
    private string GetDayTooltip(
    DateTime date,
    List<ShiftRequestDto> dayRequests,
    List<ShiftScheduleDto> daySchedules)
    {
        var sb = new StringBuilder();

        // 1行目：日付
        sb.AppendLine(date.ToString("yyyy年MM月dd日 (ddd)"));

        if (!dayRequests.Any() && !daySchedules.Any())
        {
            sb.Append("シフトなし");
            return sb.ToString();
        }

        if (daySchedules.Any())
        {
            sb.AppendLine("[確定シフト]");
            foreach (var s in daySchedules.OrderBy(x => x.ShiftType))
            {
                sb.Append("・")
                  .Append(GetUserName(s.UserId))
                  .Append("：")
                  .AppendLine(GetShiftTypeLabel(s.ShiftType));
            }
        }

        if (dayRequests.Any())
        {
            sb.AppendLine("[希望シフト]");
            foreach (var r in dayRequests.OrderBy(x => x.ShiftType))
            {
                sb.Append("・")
                  .Append(GetUserName(r.UserId))
                  .Append("：")
                  .AppendLine(GetShiftTypeLabel(r.ShiftType));
            }
        }

        return sb.ToString();
    }
}
